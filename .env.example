# Public API base URL (no trailing slash)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Canonical public site origin (no trailing slash). Used to build absolute
# og:url / canonical links on the public item page (app/item/[id]) — link
# previews in WhatsApp, iMessage, Slack etc. need absolute URLs.
# Defaults to https://dropyard.app when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Sign-In — same Web client ID as backend GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID="123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com"